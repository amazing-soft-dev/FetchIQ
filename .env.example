# Copy to .env and fill in local values. Never commit .env or real tokens.
MONGODB_URI=mongodb://localhost:27017
GITHUB_TOKEN=
DATABASE_NAME=fetchiq

# Messages to selected contacts. Leave the mailbox blank to keep sending disabled.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
