# Copy to .env and fill in local values. Never commit .env, a private key, or real tokens.
MONGODB_URI=mongodb://localhost:27017
# GitHub App: the numeric App ID, the installation ID, and the path to its downloaded .pem key.
# A relative key path is resolved from the repository root.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
DATABASE_NAME=fetchiq

# Messages to selected contacts. Leave the mailbox blank to keep sending disabled.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Sent copies use the same username and password.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SSL=true
